<mxfile host="app.diagrams.net" agent="Codex">
  <diagram id="capas-evaluador-multimodal" name="Capas evaluador multimodal">
    <mxGraphModel dx="1600" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Diagrama de funcionamiento por capas - Evaluador multimodal" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=24;" parent="1" vertex="1">
          <mxGeometry x="420" y="20" width="960" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Flujo principal de evaluacion y servicios transversales" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="520" y="60" width="760" height="30" as="geometry" />
        </mxCell>
        <mxCell id="presentacion" value="&lt;b&gt;Capa de presentacion&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Formularios de texto e imagen&lt;br&gt;- Historial&lt;br&gt;- Mensajes de estado&lt;br&gt;- Render de resultados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;align=left;spacingLeft=12;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="560" y="120" width="680" height="120" as="geometry" />
        </mxCell>
        <mxCell id="validacion" value="&lt;b&gt;Capa de validacion y normalizacion&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Limpieza de textos&lt;br&gt;- Verificacion de campos obligatorios&lt;br&gt;- Verificacion de imagenes validas&lt;br&gt;- Control de tamano y formato" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;align=left;spacingLeft=12;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="560" y="280" width="680" height="130" as="geometry" />
        </mxCell>
        <mxCell id="texto" value="&lt;b&gt;Capa de evaluacion textual&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Fuente + Texto 1, 2 y 3&lt;br&gt;- BLEU por candidato&lt;br&gt;- BERTScore precision, recall y F1&lt;br&gt;- Comparacion uno a uno frente a la fuente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;spacingLeft=12;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="200" y="470" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="visual" value="&lt;b&gt;Capa de evaluacion visual&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Imagenes 1, 2 y 3 obligatorias&lt;br&gt;- Imagen 4 opcional como referencia&lt;br&gt;- CLIPScore para Imagen 1, 2 y 3&lt;br&gt;- FID 1 vs 2,3,4 | 2 vs 1,3,4 | 3 vs 1,2,4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;align=left;spacingLeft=12;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1080" y="470" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="previsual" value="&lt;b&gt;Capa de preprocesamiento visual&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Conversion a RGB&lt;br&gt;- Conversion a tensor&lt;br&gt;- Resize para FID&lt;br&gt;- Preparacion de lotes de imagenes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=left;spacingLeft=12;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1080" y="660" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="compatibilidad" value="&lt;b&gt;Capa de compatibilidad de modelos y metricas&lt;/b&gt;&lt;br&gt;&lt;br&gt;- CPU o GPU automatica&lt;br&gt;- Cache de modelos&lt;br&gt;- Truncamiento para CLIP&lt;br&gt;- Fallbacks ante incompatibilidades" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;align=left;spacingLeft=12;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="760" y="660" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="render" value="&lt;b&gt;Capa de resultados&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Metricas en pantalla&lt;br&gt;- Interpretacion textual&lt;br&gt;- Exito, warning y error&lt;br&gt;- Preparacion para guardado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;align=left;spacingLeft=12;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="560" y="860" width="680" height="130" as="geometry" />
        </mxCell>
        <mxCell id="persistencia" value="&lt;b&gt;Capa de persistencia&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Guarda evaluaciones de texto&lt;br&gt;- Guarda evaluaciones de imagen&lt;br&gt;- Almacena binarios de imagen&lt;br&gt;- Crea tablas automaticamente si la base existe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=left;spacingLeft=12;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1380" y="860" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="seguridad" value="&lt;b&gt;Capa de seguridad de escritura&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Contraseña de guardado&lt;br&gt;- Desbloqueo por sesion&lt;br&gt;- Puede evaluar sin guardar&lt;br&gt;- Controla acceso a persistencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacingLeft=12;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1380" y="620" width="320" height="160" as="geometry" />
        </mxCell>
